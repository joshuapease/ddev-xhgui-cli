#!/usr/bin/env bash
#ddev-generated
## Description: Query XHGui profiling data from the CLI
## Usage: xhgui-query <subcommand> [flags]
## Example: "ddev xhgui-query runs --limit 10"
## ExecRaw: true

set -eu -o pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PHP_SCRIPT="${SCRIPT_DIR}/../../xhgui-cli/query.php"

if [ ! -f "$PHP_SCRIPT" ]; then
  echo "Error: query.php not found at $PHP_SCRIPT" >&2
  echo "Try reinstalling: ddev add-on get joshuapease/ddev-xhgui-cli" >&2
  exit 2
fi

# TTY detection passed as env var (not flag) to keep $argv user-facing only
export XHGUI_IS_TTY=0
[ -t 1 ] && XHGUI_IS_TTY=1

# exec replaces this shell -- PHP exit code becomes the command exit code.
# auto_prepend_file is blanked so the query tool is never profiled itself:
# with profiling on, DDEV's xhprof prepend hooks CLI PHP too, and every
# invocation would otherwise pollute the runs it queries (and steal the
# "most recent run" default from the request being investigated).
exec php -d auto_prepend_file= "$PHP_SCRIPT" "$@"
